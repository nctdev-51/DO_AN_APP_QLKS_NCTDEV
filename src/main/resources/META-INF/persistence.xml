<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="qlkhachsan-pu" transaction-type="RESOURCE_LOCAL">
        <!-- Jakarta Persistence (JPA) Provider - Hibernate -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- ========== ENTITIES PACKAGE ========== -->
        <!-- Tất cả Entity classes được định nghĩa ở đây -->
        <class>iuh.fit.core.entity.TaiKhoan</class>
        <class>iuh.fit.core.entity.NhanVien</class>
        <class>iuh.fit.core.entity.KhachHang</class>
        <class>iuh.fit.core.entity.Phong</class>
        <class>iuh.fit.core.entity.PhieuDatPhong</class>
        <class>iuh.fit.core.entity.HoaDon</class>
        <class>iuh.fit.core.entity.DichVu</class>
        <class>iuh.fit.core.entity.KhuyenMai</class>
        <class>iuh.fit.core.entity.CaLamViec</class>
        <class>iuh.fit.core.entity.PhanCongCaLamViec</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- ========== DATABASE CONNECTION PROPERTIES ========== -->
            <!-- Cầu hình kết nối MariaDB -->
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mariadb://localhost:3306/qlkhachsan_db?useUnicode=true&amp;characterEncoding=utf-8&amp;allowMultiQueries=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="sapassword"/>

            <!-- ========== HIBERNATE CONFIGURATION ========== -->
            <!-- Dialect cho MariaDB -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>

            <!-- Hiển thị SQL trong console (Debug) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>

            <!-- SQL Generation Strategy: update | create-drop | create | validate -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Connection Pool Configuration (HikariCP) -->
            <property name="hibernate.hikari.maximumPoolSize" value="20"/>
            <property name="hibernate.hikari.minimumIdle" value="5"/>
            <property name="hibernate.hikari.connectionTimeout" value="30000"/>
            <property name="hibernate.hikari.idleTimeout" value="600000"/>
            <property name="hibernate.hikari.maxLifetime" value="1800000"/>

            <!-- Transaction Configuration -->
            <property name="hibernate.connection.autocommit" value="false"/>

            <!-- Logging Configuration -->
            <property name="hibernate.generate_statistics" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
