<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="iuh.fit.presentation.controller.DashboardController" fitToWidth="true">
    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">

        <!-- Header Stats -->
        <HBox spacing="20">
            <!-- Card 1: Phòng Trống -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-min-width: 200;">
                <Label text="Phòng Trống" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblPhongTrong" text="12" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
                <Label text="Sẵn sàng cho khách" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- Card 2: Phòng Đã Đặt -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-min-width: 200;">
                <Label text="Phòng Đã Đặt" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblPhongDaDat" text="5" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                <Label text="Đang được sử dụng" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- Card 3: Khách Hôm Nay -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-min-width: 200;">
                <Label text="Khách Hôm Nay" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblKhachHomNay" text="8" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                <Label text="Check-in/Check-out" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- Card 4: Doanh Thu Hôm Nay -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-min-width: 200;">
                <Label text="Doanh Thu Hôm Nay" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblDoanhThuHomNay" text="₫2.5M" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                <Label text="Thu nhập trong ngày" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </HBox>

        <!-- Charts Row -->
        <HBox spacing="20">
            <!-- Revenue Chart -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-min-width: 500; -fx-max-width: 700;">
                <Label text="📊 Doanh Thu 7 Ngày Gần Nhất" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <LineChart fx:id="chartRevenue" createSymbols="true" style="-fx-min-height: 250;">
                    <xAxis>
                        <CategoryAxis side="BOTTOM"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT"/>
                    </yAxis>
                </LineChart>
            </VBox>

            <!-- Room Status Pie Chart -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-min-width: 400;">
                <Label text="📈 Tình Trạng Phòng" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <PieChart fx:id="chartRoomStatus" style="-fx-min-height: 250;"/>
            </VBox>
        </HBox>

        <!-- Recent Bookings Table -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <Label text="📋 Phiếu Đặt Phòng Gần Đây" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <TableView fx:id="tableRecentBookings" prefHeight="200">
                <columns>
                    <TableColumn text="Mã Phiếu" prefWidth="80"/>
                    <TableColumn text="Khách Hàng" prefWidth="150"/>
                    <TableColumn text="Phòng" prefWidth="80"/>
                    <TableColumn text="Ngày Nhận" prefWidth="100"/>
                    <TableColumn text="Ngày Trả" prefWidth="100"/>
                    <TableColumn text="Tình Trạng" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>

