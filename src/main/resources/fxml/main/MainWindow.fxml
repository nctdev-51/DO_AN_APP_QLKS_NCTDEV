<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="iuh.fit.presentation.controller.MainController" stylesheets="@../../styles/main.css">

    <!-- LEFT SIDEBAR MENU -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #2c3e50; -fx-min-width: 250px;">

            <!-- Logo/Header -->
            <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: #34495e; -fx-border-color: #1c2833; -fx-border-width: 0 1 1 0;">
                <Label text="🏨 HOTEL MANAGEMENT" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="TATP System" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Menu Items -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-padding: 0;">
                <VBox spacing="2" style="-fx-padding: 10;">

                    <!-- Dashboard -->
                    <Button fx:id="btnDashboard" text="📊 Trang Chủ" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleDashboard" maxWidth="Infinity"/>

                    <!-- Phòng -->
                    <Button fx:id="btnPhong" text="🛏️ Quản Lý Phòng" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handlePhong" maxWidth="Infinity"/>

                    <!-- Đặt Phòng -->
                    <Button fx:id="btnDatPhong" text="📝 Đặt Phòng" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleDatPhong" maxWidth="Infinity"/>

                    <!-- Khách Hàng -->
                    <Button fx:id="btnKhachHang" text="👥 Quản Lý Khách Hàng" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleKhachHang" maxWidth="Infinity"/>

                    <!-- Nhân Viên -->
                    <Button fx:id="btnNhanVien" text="💼 Quản Lý Nhân Viên" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleNhanVien" maxWidth="Infinity"/>

                    <!-- Dịch Vụ -->
                    <Button fx:id="btnDichVu" text="🛎️ Quản Lý Dịch Vụ" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleDichVu" maxWidth="Infinity"/>

                    <!-- Khuyến Mại -->
                    <Button fx:id="btnKhuyenMai" text="🎁 Khuyến Mại" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleKhuyenMai" maxWidth="Infinity"/>

                    <!-- Báo Cáo -->
                    <Button fx:id="btnBaoCao" text="📈 Báo Cáo" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #34495e; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleBaoCao" maxWidth="Infinity"/>

                    <Separator style="-fx-padding: 10 0;"/>

                    <!-- Logout -->
                    <Button fx:id="btnLogout" text="🚪 Đăng Xuất" style="-fx-padding: 12px 20px; -fx-text-alignment: left; -fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 12px;" onAction="#handleLogout" maxWidth="Infinity"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- TOP HEADER -->
    <top>
        <HBox spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 1 0;">
            <Label fx:id="lblTitle" text="Trang Chủ" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label fx:id="lblUser" text="Người dùng: Admin" style="-fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="lblTime" text="Thời gian: " style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </HBox>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <BorderPane fx:id="contentPane" style="-fx-background-color: #f8f9fa;">
            <!-- Placeholder hoặc các scene khác sẽ được load vào đây -->
        </BorderPane>
    </center>

</BorderPane>

