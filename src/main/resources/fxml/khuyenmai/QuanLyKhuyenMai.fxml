<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="iuh.fit.presentation.controller.QuanLyKhuyenMaiController">

    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearch" promptText="Tìm kiếm khuyến mại..." prefWidth="250"/>
                <ComboBox fx:id="cbLoaiKhuyenMai" prefWidth="150" promptText="Loại khuyến mại"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Thêm" onAction="#handleThem"/>
                <Button text="✏️ Sửa" onAction="#handleSua"/>
                <Button text="🗑️ Xóa" onAction="#handleXoa"/>
                <Button text="🔄 Làm Mới" onAction="#handleLamMoi"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableKhuyenMai">
            <columns>
                <TableColumn text="Mã KM" prefWidth="80"/>
                <TableColumn text="Tên Khuyến Mại" prefWidth="200"/>
                <TableColumn text="Ngày Bắt Đầu" prefWidth="120"/>
                <TableColumn text="Ngày Kết Thúc" prefWidth="120"/>
                <TableColumn text="Loại KM" prefWidth="100"/>
                <TableColumn text="Chiết Khấu" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

</BorderPane>

