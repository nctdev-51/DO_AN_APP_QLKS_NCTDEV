<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="iuh.fit.presentation.controller.BaoCaoController">

    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Từ ngày:"/>
                <DatePicker fx:id="dpTuNgay" prefWidth="120"/>
                <Label text="Đến ngày:"/>
                <DatePicker fx:id="dpDenNgay" prefWidth="120"/>
                <ComboBox fx:id="cbBaoCaoLoai" prefWidth="150" promptText="Chọn báo cáo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔍 Tìm" onAction="#handleTim"/>
                <Button text="📥 Xuất Excel" onAction="#handleXuatExcel"/>
                <Button text="🖨️ In" onAction="#handleIn"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane style="-fx-padding: 10;">
            <!-- Tab 1: Doanh Thu -->
            <Tab text="Doanh Thu" closable="false">
                <TableView fx:id="tableDoanhThu">
                    <columns>
                        <TableColumn text="Ngày" prefWidth="100"/>
                        <TableColumn text="Số Phòng Đặt" prefWidth="120"/>
                        <TableColumn text="Doanh Thu" prefWidth="120"/>
                        <TableColumn text="Chi Phí" prefWidth="120"/>
                        <TableColumn text="Lợi Nhuận" prefWidth="120"/>
                    </columns>
                </TableView>
            </Tab>

            <!-- Tab 2: Khách Hàng -->
            <Tab text="Khách Hàng" closable="false">
                <TableView fx:id="tableKhachHang">
                    <columns>
                        <TableColumn text="Loại Khách" prefWidth="120"/>
                        <TableColumn text="Số Lượng" prefWidth="100"/>
                        <TableColumn text="Tỷ Lệ" prefWidth="100"/>
                    </columns>
                </TableView>
            </Tab>

            <!-- Tab 3: Phòng -->
            <Tab text="Phòng" closable="false">
                <TableView fx:id="tablePhong">
                    <columns>
                        <TableColumn text="Phòng" prefWidth="100"/>
                        <TableColumn text="Lần Đặt" prefWidth="100"/>
                        <TableColumn text="Doanh Thu" prefWidth="120"/>
                        <TableColumn text="Tỷ Lệ Sử Dụng" prefWidth="120"/>
                    </columns>
                </TableView>
            </Tab>
        </TabPane>
    </center>

</BorderPane>

