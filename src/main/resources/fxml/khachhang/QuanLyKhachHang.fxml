<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="iuh.fit.presentation.controller.QuanLyKhachHangController">

    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearch" promptText="Tìm kiếm khách hàng..." prefWidth="250"/>
                <ComboBox fx:id="cbLoaiKhach" prefWidth="150" promptText="Loại khách"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Thêm" onAction="#handleThem"/>
                <Button text="✏️ Sửa" onAction="#handleSua"/>
                <Button text="🗑️ Xóa" onAction="#handleXoa"/>
                <Button text="🔄 Làm Mới" onAction="#handleLamMoi"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableKhachHang">
            <columns>
                <TableColumn text="Mã Khách" prefWidth="80"/>
                <TableColumn text="Tên Khách" prefWidth="150"/>
                <TableColumn text="Số Điện Thoại" prefWidth="120"/>
                <TableColumn text="Ngày Sinh" prefWidth="100"/>
                <TableColumn text="Loại Khách" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

</BorderPane>

